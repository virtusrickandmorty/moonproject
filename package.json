{
  "name": "moonproject",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "dev:server": "tsx apps/server/src/main.ts",
    "practice-data": "tsx apps/server/src/platform/practice/data.ts",
    "restore": "tsx apps/server/src/modules/BAK/cli.ts",
    "blind-pack": "tsx tools/blind-pack.ts",
    "compare-blind": "tsx tools/compare-blind.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
